# PostgreSQL connection string (matches docker-compose.yml if you use it: docker compose up -d)
DATABASE_URL="postgresql://photo_delivery:photo_delivery@localhost:5432/photo_delivery"

# Session JWT signing secret (generate with: openssl rand -base64 32)
SESSION_SECRET="replace-with-a-long-random-string"

# Storage: "local" writes to disk (os.tmpdir()) with no cloud account needed —
# good for local dev/testing. Switch to "r2" (the default when unset) once real
# Cloudflare R2 credentials are filled in below.
STORAGE_PROVIDER="local"

# Cloudflare R2 (S3-compatible) — only needed when STORAGE_PROVIDER=r2
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="photo-delivery"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_PUBLIC_URL="https://your-public-r2-domain.example.com"

# Gallery access token signing secret (short-lived tokens issued after password verify)
GALLERY_TOKEN_SECRET="replace-with-a-long-random-string"

# Worker
WORKER_POLL_INTERVAL_MS="5000"
WORKER_TMP_DIR="./worker/tmp"
# FFMPEG_PATH="C:/ffmpeg/bin/ffmpeg.exe"   # only needed if ffmpeg isn't on PATH

# Seed script (creates the single admin account: npm run db:seed)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-now"
ADMIN_NAME="Your Studio"

# Email (Resend) — new-comment and new-public-gallery notifications.
# Without these, emails are just logged to the console/worker log instead of sent.
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="Your Studio <notifications@yourdomain.com>"

# Used to build links in notification emails
APP_URL="http://localhost:3000"

# Google sign-in for visitor accounts ("Continue with Google"). Leave blank to hide the button.
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
