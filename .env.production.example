# Production settings — copy to .env on the server and fill in every value.
# Never commit the real .env.

# ---- Public address ---------------------------------------------------------
# Must be the https:// address people use. deploy.sh builds the Caddy site from it,
# and it is used in emailed links and the Google sign-in redirect.
# Before you own a domain you can use <server-ip-with-dashes>.sslip.io, e.g.
#   APP_URL="https://203-0-113-10.sslip.io"
APP_URL="https://example.com"

# ---- Database (Neon) --------------------------------------------------------
# Pooled connection string (host contains "-pooler") — used by the app and worker.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection (same string without "-pooler") — used only for migrations.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
# Do not set NEON_WS here: it only exists for networks that block port 5432.

# ---- Secrets (generate each with: openssl rand -base64 32) -------------------
SESSION_SECRET="CHANGE-ME"
GALLERY_TOKEN_SECRET="CHANGE-ME"

# ---- File storage (Cloudflare R2) --------------------------------------------
STORAGE_PROVIDER="r2"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="photo-delivery"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_PUBLIC_URL=""

# ---- Admin account (used once by: npm run db:seed) ---------------------------
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="use-a-long-unique-password"
ADMIN_NAME="Your Studio"

# ---- Email (Resend) ----------------------------------------------------------
# Without these, emails are only written to the log and never sent.
# Before the domain is verified, EMAIL_FROM="onboarding@resend.dev" can send to your own address only.
RESEND_API_KEY=""
EMAIL_FROM="Your Studio <notifications@example.com>"

# ---- Google sign-in for visitors (optional; blank hides the button) ----------
# Authorized redirect URI to register: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Worker (ffmpeg / sharp) -------------------------------------------------
WORKER_POLL_INTERVAL_MS="5000"
# Scratch space for transcoding — needs room for the largest original video twice over.
WORKER_TMP_DIR="/var/tmp/photo-delivery-worker"
# ffmpeg is installed system-wide by setup-server.sh, so FFMPEG_PATH is not needed.
